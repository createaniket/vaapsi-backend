# Server
NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL="postgresql://vaapsi:vaapsi@localhost:5432/vaapsi"

# JWT secrets (MUST be at least 32 characters)
JWT_ACCESS_SECRET="dev_access_secret_please_change_me_0123456789"
JWT_REFRESH_SECRET="dev_refresh_secret_please_change_me_0123456789"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# Loyalty rules (Phase 1 confirmed scope)
POINTS_PER_RUPEE=1
MIN_REDEEM_POINTS=100
POINT_VALUE_RUPEES=1
REDEEM_SPLIT_VAAPSI=0.7
REDEEM_SPLIT_EXTERNAL=0.3
REPAIR_EARN_RATE=0.05
RETURN_EOL_EARN_RATE=0.02

# Third-party gateways (client-owned accounts; billed at actuals)
SMS_PROVIDER_KEY=""
WHATSAPP_PROVIDER_KEY=""
EMAIL_PROVIDER_KEY=""
DPP_PROVIDER_KEY=""

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS="*"
